class ConfigError(Exception):
    pass


def log(msg):
    line = f"{dt.datetime.now().astimezone():%Y-%m-%d %H:%M:%S%z} {msg}"
    print(line)
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(line + "\n")


# ---------------------------------------------------------------- config

def load_config(path=None):
    path = path or CONFIG_FILE
    try:
        with open(path, "rb") as f:
            cfg = tomllib.load(f)
    except FileNotFoundError:
        raise ConfigError(f"{path} nao existe; rode `droid-tier init`")
    except tomllib.TOMLDecodeError as e:
        raise ConfigError(f"{path}: {e}")

    tiers = cfg.get("tier") or []
    if not tiers:
        raise ConfigError("nenhum [[tier]] definido")
    providers = cfg.get("providers") or {}
    seen = set()
    for i, t in enumerate(tiers, 1):
        name = t.get("name")
        if not name:
            raise ConfigError(f"[[tier]] #{i} sem name")
        if name in seen:
            raise ConfigError(f"degrau {name!r} repetido")
        seen.add(name)
        if t.get("pool") not in (None, *POOLS):
            raise ConfigError(f"degrau {name!r}: pool deve ser {' ou '.join(POOLS)}")
        if t.get("pool") and t.get("provider"):
            raise ConfigError(f"degrau {name!r}: use pool (Factory) ou provider (fallback), nao os dois")
        if t.get("provider") and t["provider"] not in providers:
            raise ConfigError(f"degrau {name!r}: provider {t['provider']!r} nao esta em [providers]")
        unknown = set(t) - {"name", "pool", "provider", *ROLES}
        if unknown:
            raise ConfigError(f"degrau {name!r}: campos desconhecidos {sorted(unknown)}")
        if not set(t) & set(ROLES):
            raise ConfigError(f"degrau {name!r} nao define nenhum papel")
    for pname, p in providers.items():
        if not p.get("base_url"):
            raise ConfigError(f"provider {pname!r} sem base_url")
    return {
        "threshold": float(cfg.get("threshold", 95)),
        "settings": os.path.expanduser(cfg.get("settings", DEFAULT_SETTINGS)),
        "api": cfg.get("factory_api", DEFAULT_API).rstrip("/"),
        "providers": providers,
        "tiers": tiers,
    }


def norm_url(u):
    return (u or "").rstrip("/").lower()


def resolve_tier(tier, cfg, settings):
    """Degrau do config -> {papel: (id do modelo no Droid, esforco)}."""
    provider = cfg["providers"].get(tier.get("provider")) if tier.get("provider") else None
    out = {}
    for role in ROLES:
        spec = tier.get(role)
        if spec is None:
            continue
        model, _, effort = spec.partition("@")
        if provider and not model.startswith("custom:"):
            model = custom_model_id(settings, provider["base_url"], model, tier["name"])
        out[role] = (model, effort or None)
    return out


def custom_model_id(settings, base_url, model, tier_name):
    matches = [m for m in settings.get("customModels") or []
               if norm_url(m.get("baseUrl")) == norm_url(base_url) and m.get("model") == model]
    if not matches:
        raise ConfigError(f"degrau {tier_name!r}: nenhum customModel com model={model!r} "
                          f"e baseUrl={base_url!r} no settings.json do Droid")
    return matches[0]["id"]


def resolve_all(cfg, settings):
    return {t["name"]: resolve_tier(t, cfg, settings) for t in cfg["tiers"]}


# ---------------------------------------------------------------- limites

def api_key():
    key = os.environ.get("FACTORY_API_KEY")
    if key:
        return key
    try:
        with open(KEY_FILE, encoding="utf-8") as f:
            for line in f:
                if line.strip().startswith("FACTORY_API_KEY="):
                    return line.split("=", 1)[1].strip().strip("'\"")
    except FileNotFoundError:
        pass
    raise ConfigError(f"sem FACTORY_API_KEY (nem no ambiente, nem em {KEY_FILE})")


def fetch_limits(cfg):
    # Endpoint nao documentado, o mesmo que o CLI do Droid consulta.
    req = urllib.request.Request(cfg["api"] + "/api/billing/limits", headers={
        "Authorization": f"Bearer {api_key()}",
        "Accept": "application/json",
        "User-Agent": "droid-tier",
    })
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r).get("limits") or {}


def pool_hits(pool, threshold, now=None):
    """Janelas ativas do pool que passaram do limiar, como 'weekly 97%'."""
    if not pool:
        return []
    now = now or dt.datetime.now(dt.timezone.utc)
    hits = []
    for name in WINDOWS:
        b = pool.get(name) or {}
        pct = b.get("usedPercent")
        if pct is None or pct < threshold:
            continue
        end = b.get("windowEnd")
        if end and dt.datetime.fromisoformat(end.replace("Z", "+00:00")) <= now:
            continue  # janela ja virou, o numero e velho
        hits.append(f"{name} {pct:.0f}%")
    return hits


def pick_tier(cfg, limits, now=None):
    """Primeiro degrau com folga; se todos estourados, o ultimo. Devolve (nome, motivos)."""
    hits = {p: pool_hits(limits.get(p), cfg["threshold"], now) for p in POOLS}
    for t in cfg["tiers"]:
        if not t.get("pool") or not hits[t["pool"]]:
            return t["name"], hits
    return cfg["tiers"][-1]["name"], hits


def describe(limits):
    out = []
    for pool in POOLS:
        p = limits.get(pool) or {}
        parts = []
        for name in WINDOWS:
            b = p.get(name) or {}
            if "usedPercent" in b:
                end = f" (vira {b['windowEnd']})" if b.get("windowEnd") else ""
                parts.append(f"{name} {b['usedPercent']:.0f}%{end}")
        out.append(f"  {pool}: " + (", ".join(parts) if parts else "sem dados"))
    return "\n".join(out)


# ---------------------------------------------------------------- settings

def load_settings(path):
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def get_role(s, role):
    section, mk, ek = ROLES[role]
    d = s.get(section, {}) if section else s
    return d.get(mk), d.get(ek)


def matches(s, profile):
    return all(get_role(s, role)[0] == model and (effort is None or get_role(s, role)[1] == effort)
               for role, (model, effort) in profile.items())


def current_tier(s, resolved):
    for name, profile in resolved.items():
        if matches(s, profile):
            return name
    return None  # misto / editado a mao


def apply(path, s, profile):
    if matches(s, profile):
        return False
    for role, (model, effort) in profile.items():
        section, mk, ek = ROLES[role]
        d = s.setdefault(section, {}) if section else s
        d[mk] = model
        if effort:
            d[ek] = effort
    # Escrita atomica no mesmo diretorio, mantendo 0600 (o arquivo tem chaves de API).
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".settings.droid-tier.")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(s, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    return True


def read_pin():
    try:
        with open(PIN_FILE, encoding="utf-8") as f:
            return f.read().strip() or None
    except FileNotFoundError:
        return None


# ---------------------------------------------------------------- comandos

def cmd_init(_):
    if os.path.exists(CONFIG_FILE):
        sys.exit(f"{CONFIG_FILE} ja existe; nao vou sobrescrever")
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8", newline="\n") as f:
        f.write(EXAMPLE_CONFIG)
    print(f"criado {CONFIG_FILE}; ajuste os degraus e rode `droid-tier check`")


def cmd_check(_):
    cfg = load_config()
    s = load_settings(cfg["settings"])
    resolved = resolve_all(cfg, s)
    for t in cfg["tiers"]:
        origin = f"pool {t['pool']}" if t.get("pool") else f"provider {t.get('provider') or '(nenhum)'}"
        print(f"{t['name']} ({origin})")
        for role, (model, effort) in resolved[t["name"]].items():
            print(f"  {role:16} {model}" + (f" @{effort}" if effort else ""))
    last = cfg["tiers"][-1]
    if last.get("pool"):
        print(f"aviso: o ultimo degrau ({last['name']}) depende do pool {last['pool']}; "
              "sem um fallback sem pool, ele fica mesmo estourado")
    print(f"degrau atual no settings: {current_tier(s, resolved) or 'misto'}")


def cmd_pin(args):
    cfg = load_config()
    names = [t["name"] for t in cfg["tiers"]]
    if not args or args[0] not in names:
        sys.exit(f"uso: droid-tier pin {{{'|'.join(names)}}}")
    s = load_settings(cfg["settings"])
    resolved = resolve_all(cfg, s)
    before = current_tier(s, resolved) or "misto"
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(PIN_FILE, "w", encoding="utf-8") as f:
        f.write(args[0] + "\n")
    changed = apply(cfg["settings"], s, resolved[args[0]])
    log(f"pin {args[0]} (antes: {before})" + ("" if changed else ", nada a mudar"))


def cmd_unpin(_):
    if os.path.exists(PIN_FILE):
        os.remove(PIN_FILE)
    log("unpin, o timer volta a decidir")


def cmd_status_or_run(run):
    cfg = load_config()
    s = load_settings(cfg["settings"])
    resolved = resolve_all(cfg, s)
    before = current_tier(s, resolved) or "misto"
    pin = read_pin()
    try:
        limits = fetch_limits(cfg)
    except (urllib.error.URLError, OSError, ValueError) as e:
        # Sem resposta confiavel, nao mexe: melhor ficar no degrau atual do que chutar.
        log(f"falha ao consultar limites: {e}; mantendo {before}")
        sys.exit(1)

    tier, hits = pick_tier(cfg, limits)
    if not run:
        print(f"degrau atual: {before}" + (f" (fixado em {pin})" if pin else ""))
        print(f"degrau pelos limites (limiar {cfg['threshold']:.0f}%): {tier}")
        print(describe(limits))
        return
    if pin:
        return
    if apply(cfg["settings"], s, resolved[tier]):
        why = "; ".join(f"{p} {', '.join(h)}" for p, h in hits.items() if h)
        log(f"{before} -> {tier}" + (f" ({why})" if why else " (limites liberados)"))


COMMANDS = {
    "init": cmd_init,
    "check": cmd_check,
    "status": lambda a: cmd_status_or_run(False),
    "run": lambda a: cmd_status_or_run(True),
    "pin": cmd_pin,
    "unpin": cmd_unpin,
}


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd not in COMMANDS:
        sys.exit(__doc__)
    try:
        COMMANDS[cmd](sys.argv[2:])
    except ConfigError as e:
        if cmd == "run":
            log(f"erro de configuracao: {e}; nada alterado")
        else:
            print(f"erro: {e}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
